<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps the agent running, and restarts it if it stops. Secrets come from the Keychain via run.sh.
     Installed by deploy/install.sh --agent (fills in the code path, the data path and the arguments for run.sh). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mcsl.__SLUG__.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__CODE__/run.sh</string>
    __ARGS__
  </array>
  <key>WorkingDirectory</key><string>__CODE__</string>
  <key>EnvironmentVariables</key>
  <dict><key>MCSL_HOME</key><string>__DATA__</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- Give MC time to start and log in first, and don't hammer on crash loops. -->
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>__DATA__/logs/agent.log</string>
  <key>StandardErrorPath</key><string>__DATA__/logs/agent.log</string>
</dict>
</plist>
